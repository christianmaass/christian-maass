---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LatestEssays from '../components/article/LatestEssays.astro';
import PressStrip from '../components/PressStrip.astro';
import { getTranslations } from '../i18n/utils';
import { SITE_URL as siteUrl } from '../utils/config';
import heroPortrait from '../assets/christian-maass-2027.png';

const t = getTranslations();
const currentUrl = `${siteUrl}/`;
const ogImage = `${siteUrl}/og/default.jpg`;
---

<BaseLayout
  title={t.pages.index.title}
  description={t.pages.index.description}
  canonical={currentUrl}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://christianmaass.com/#person",
            "name": "Christian Maaß",
            "alternateName": "Dr. Christian Maaß",
            "honorificPrefix": "Dr.",
            "inLanguage": "de",
            "url": "https://christianmaass.com/",
            "image": "https://christianmaass.com/christian-maass.png",
            "sameAs": [
              "https://www.linkedin.com/in/christianmaass/",
              "https://www.amazon.de/stores/author/B0045949JA",
              "https://www.instagram.com/christianmaass/",
              "https://x.com/ChristianMaass"
            ],
            "jobTitle": "Managing Director & Chief Digital Officer",
            "worksFor": {
              "@type": "Organization",
              "name": "Thomann",
              "url": "https://www.thomann.de/",
              "description": "World's largest digital music retailer with approx. EUR 1.6bn revenue"
            },
            "memberOf": [
              {
                "@type": "OrganizationRole",
                "roleName": "Vorstand",
                "startDate": "2023-11-01",
                "memberOf": {
                  "@type": "Organization",
                  "additionalType": "TradeAssociation",
                  "name": "BEVH – Bundesverband E-Commerce und Versandhandel Deutschland e.V.",
                  "description": "Wirtschaftsverband für E-Commerce und Versandhandel",
                  "url": "https://www.bevh.org/"
                }
              }
            ],
            "knowsAbout": [
              "Synchronisation digitaler Geschäfte",
              "Digital Operating Models",
              "E-Commerce-Skalierung",
              "KI im Operating",
              "Board-Perspektive auf Digital",
              "Plattform-Transformation",
              "Cross-border Commerce",
              "Executive Leadership",
              "Digital Governance"
            ],
            "description": "Unternehmer und Autor. Geschäftsführer Thomann.io, Vorstand BEVH. Digitale Geschäfte gewinnen dort, wo Strategie, Organisation und Technik/KI synchron laufen.",
            "email": "christian@christianmaass.com",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Am Leinritt 7",
              "addressLocality": "Bamberg",
              "postalCode": "96049",
              "addressRegion": "Bayern",
              "addressCountry": "DE"
            }
          },
          {
            "@type": "ProfilePage",
            "@id": "https://christianmaass.com/#webpage",
            "url": "https://christianmaass.com/",
            "name": "Dr. Christian Maaß · Digitalstrategie, KI & E-Commerce",
            "description": "Digitale Geschäfte gewinnen dort, wo Strategie, Organisation und Technik/KI synchron laufen. Daran arbeite ich – Geschäftsführer Thomann.io, Vorstand BEVH.",
            "inLanguage": "de",
            "isPartOf": {
              "@id": "https://christianmaass.com/#website"
            },
            "about": {
              "@id": "https://christianmaass.com/#person"
            },
            "mainEntity": {
              "@id": "https://christianmaass.com/#person"
            },
            "breadcrumb": {
              "@id": "https://christianmaass.com/#breadcrumb"
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://christianmaass.com/#website",
            "url": "https://christianmaass.com/",
            "name": "Christian Maaß",
            "description": "Unternehmer und Autor. Digitale Geschäfte gewinnen, wenn Strategie, Organisation und Technik synchron laufen.",
            "publisher": {
              "@id": "https://christianmaass.com/#person"
            },
            "inLanguage": "de"
          }
        ]
      }
    </script>
  </Fragment>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="hero-headline">
          {t.pages.index.hero.headlineLeading}<span class="hero-accent"
            >{t.pages.index.hero.headlineAccent}</span
          >{t.pages.index.hero.headlineTrailing}
        </h1>
        <p class="hero-lead">{t.pages.index.hero.lead}</p>
        <p class="hero-credentials">{t.pages.index.hero.credentialsLine}</p>
      </div>
      <div class="hero-portrait-wrap">
        <Image
          src={heroPortrait}
          alt={t.pages.index.hero.portraitAlt}
          class="hero-portrait"
          widths={[270, 540, 1080]}
          sizes="(max-width: 900px) 100vw, 540px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <PressStrip />

  <LatestEssays />
</BaseLayout>

<style>
  .hero {
    padding: var(--space-5) 0 0 0;
  }
  .hero-grid {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding-x);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-content {
    max-width: 720px;
    padding-bottom: var(--space-4);
    /* hebt die globale Mobil-Regel `.hero-content { order: 1 }` aus styles.css auf */
    order: 0;
  }
  .hero-headline {
    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    font-weight: var(--weight-display);
    line-height: var(--line-height-hero);
    letter-spacing: var(--letter-spacing-hero);
    color: var(--color-text-strong);
    margin: 0;
    max-width: 14ch;
  }
  .hero-accent {
    color: var(--color-accent);
  }
  .hero-lead {
    margin: var(--space-3) 0 0 0;
    font-family: var(--font-family-base);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 52ch;
  }
  .hero-credentials {
    margin: var(--space-3) 0 0 0;
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-eyebrow);
    color: var(--color-text-muted);
    line-height: 1.3;
  }
  .hero-portrait-wrap {
    width: 100%;
    align-self: end;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  /* Freigestelltes Porträt: unten bündig, damit es auf der Linie der PressStrip sitzt */
  .hero-portrait {
    display: block;
    width: 100%;
    max-width: 540px;
    height: auto;
    /* halb entsättigt: zwischen Vollfarbe und dem früheren Graustufen-Porträt */
    filter: saturate(0.5);
  }

  @media (max-width: 900px) {
    .hero {
      padding: var(--space-5) 0 0 0;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-headline {
      max-width: 16ch;
    }
  }
</style>
