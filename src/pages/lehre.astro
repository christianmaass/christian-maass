---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n/utils';
import { SITE_URL as siteUrl } from '../utils/config';
import { webPage } from '../utils/jsonLd';

const t = getTranslations();
const currentUrl = `${siteUrl}/lehre`;
const ogImage = `${siteUrl}/lehre-dr-christian-maass.png`;

type PillarKey = 'kiOperating' | 'grundlagen' | 'boardPerspective';
const pillarOrder: PillarKey[] = ['kiOperating', 'grundlagen', 'boardPerspective'];

const lehrePageSchema = webPage({
  path: '/lehre/',
  name: t.pages.lehre.title,
  description: t.pages.lehre.description,
});
---

<Fragment slot="head">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(lehrePageSchema)} />
</Fragment>

<BaseLayout
  title={t.pages.lehre.title}
  description={t.pages.lehre.description}
  canonical={currentUrl}
  ogImage={ogImage}
>
  <section class="content-wrapper">
    <header class="page-header">
      <h1>{t.pages.lehre.h1}</h1>
      <p class="lead">{t.pages.lehre.intro}</p>
    </header>

    <section class="talks-section">
      <p class="section-eyebrow">{t.pages.lehre.talks.eyebrow}</p>
      <h2>{t.pages.lehre.talks.title}</h2>
      <p class="section-intro">{t.pages.lehre.talks.intro}</p>
      <div class="content-box-row">
        {
          pillarOrder.map((key) => (
            <div class="content-box">
              <h3>{t.pages.lehre.talks[key].title}</h3>
              <p>{t.pages.lehre.talks[key].description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <figure class="talks-figure">
      <img
        src="/lehre-christian-maass.png"
        alt='Christian Maaß bei Thomann-Vortrag: "Die vergessenen Grundlagen im E-Commerce"'
        loading="lazy"
      />
      <figcaption>Vortrag „Die vergessenen Grundlagen im E-Commerce" – Säule 2 live.</figcaption>
    </figure>

    <section class="university-section">
      <p class="section-eyebrow">{t.pages.lehre.university.eyebrow}</p>
      <h2>{t.pages.lehre.university.title}</h2>
      <p>{t.pages.lehre.university.institution}</p>
      <p class="current-seminar"><strong>{t.pages.lehre.university.current}</strong></p>
    </section>

    <aside class="page-cta">
      <h2>{t.pages.lehre.ctaSection.headline}</h2>
      <p>{t.pages.lehre.ctaSection.text}</p>
      <a href={'/kontakt'} class="cta-btn">{t.pages.lehre.ctaSection.button}</a>
    </aside>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 3rem;
    padding-top: 2rem;
  }
  .page-header h1 {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-display);
    color: var(--color-text-strong);
    margin: 0 0 1rem 0;
    line-height: 1.15;
  }
  .page-header .lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 62ch;
  }
  .talks-section,
  .university-section {
    margin-bottom: 4rem;
  }
  .talks-figure {
    margin: 0 0 var(--space-6) 0;
    padding: 0;
  }
  .talks-figure img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
  }
  .talks-figure figcaption {
    margin-top: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .section-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--letter-spacing-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem 0;
  }
  .talks-section h2,
  .university-section h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-display);
    color: var(--color-text-strong);
    margin: 0 0 1rem 0;
    line-height: 1.25;
  }
  .section-intro {
    max-width: 80ch;
    margin: 0 0 2rem 0;
    color: var(--color-text);
    line-height: 1.6;
  }
  .university-section p {
    max-width: 70ch;
    line-height: 1.65;
    color: var(--color-text);
    margin: 0 0 1rem 0;
  }
  .current-seminar {
    padding: 1rem 1.25rem;
    background: var(--color-accent-soft);
    border-radius: var(--radius-sm);
  }
  .page-cta {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .page-cta h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.35rem;
    color: var(--color-text-strong);
    border: none;
    padding: 0;
  }
  .page-cta p {
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
